---
/** About: the "about" page entry's text beside a drawing, the numbers, the team and the quotes (src/site.ts). */
import ArticleHeader from "@astronomic/ui/components/ArticleHeader.astro";
import Container from "@astronomic/ui/components/Container.astro";
import Media from "@astronomic/ui/components/Media.astro";
import Prose from "@astronomic/ui/components/Prose.astro";
import Split from "@astronomic/ui/components/Split.astro";
import StatsGrid from "@astronomic/ui/components/StatsGrid.astro";
import TeamSplit from "@astronomic/ui/components/TeamSplit.astro";
import TestimonialGrid from "@astronomic/ui/components/TestimonialGrid.astro";
import { useContent } from "~/content";
import RichText from "../components/RichText.astro";
import Base from "../layouts/Base.astro";
import { about } from "../site";

const page = await useContent(Astro).pages.get("about");
if (!page) {
	return Astro.rewrite("/404");
}
---

<Base title={page.seo?.title ?? page.title} description={page.seo?.description} image={page.seo?.image} canonical={page.seo?.canonical} entry={page} index={{ kind: "pages", title: page.title }} card>
	<Container class="pt-group">
		<ArticleHeader title={page.title} />
		{/* The drawing stays lazy, with no fetchpriority: it is not the entry's photo (the share check reads that). */}
		<Split class="mt-blocks items-center">
			<Prose class="site-prose"><RichText value={page.body} /></Prose>
			<Media src={about.image.src} alt={about.image.alt} width={about.image.width} height={about.image.height} ratio="4/3" />
		</Split>
	</Container>
	<Container><StatsGrid heading={about.stats.heading} text={about.stats.text} items={about.stats.items} class="pt-section" /></Container>
	<Container><TeamSplit heading={about.team.heading} text={about.team.text} items={about.team.items} class="pt-section" /></Container>
	<Container><TestimonialGrid heading={about.testimonials.heading} text={about.testimonials.text} items={about.testimonials.items} class="pt-section" /></Container>
</Base>

{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "Starter",
		"description": "A product site starter: a blog, guides in a series and plain pages",
		"author": "Astronomic"
	},
	"settings": {
		"title": "Astronomic UI",
		"tagline": "A fast, simple site for your product."
	},
	"collections": [
		{
			"slug": "posts",
			"label": "Posts",
			"labelSingular": "Post",
			"urlPattern": "/posts/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"scheduling",
				"search",
				"seo"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
